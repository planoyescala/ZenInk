<Window
    x:Class="ZenInk_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZenInk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ZenInk"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        No title bar row of its own: the content is extended into it so the
        document tabs can sit on that line, the way a browser does. The drag
        region and the space for the caption buttons come from the TabView's
        header and footer in MainPage.
    -->
    <Frame x:Name="RootFrame" />
</Window>
