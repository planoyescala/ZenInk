<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ZenInk_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZenInk_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                Los tintes de los iconos.

                Solo los llevan las herramientas cuyo color significa algo en el
                oficio — la nube de revisión es roja y el resaltador amarillo en
                cualquier plano — y la maquinaria (abrir, imprimir, girar) se
                queda gris a propósito: si la barra gasta los mismos colores que
                las marcas, la hoja pierde el código que tenía.

                Cada uno va por pares porque un color elegido sobre papel blanco
                se apaga sobre el gris de la barra oscura hasta parecer
                deshabilitado. En oscuro suben de luminosidad y bajan de
                saturación; no son el mismo color aclarado.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IconRevisionBrush" Color="#C0392B" />
                    <SolidColorBrush x:Key="IconHighlightBrush" Color="#D9A916" />
                    <SolidColorBrush x:Key="IconInkBrush" Color="#CC5F34" />
                    <SolidColorBrush x:Key="IconSignatureBrush" Color="#2F6FB5" />
                    <SolidColorBrush x:Key="IconSaveBrush" Color="#3E8E52" />
                    <SolidColorBrush x:Key="IconCaptureBrush" Color="#2F6FB5" />
                    <SolidColorBrush x:Key="IconMeasureBrush" Color="#7A5AA8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="IconRevisionBrush" Color="#F0705C" />
                    <SolidColorBrush x:Key="IconHighlightBrush" Color="#F0C64A" />
                    <SolidColorBrush x:Key="IconInkBrush" Color="#F08A5C" />
                    <SolidColorBrush x:Key="IconSignatureBrush" Color="#6FB2F0" />
                    <SolidColorBrush x:Key="IconSaveBrush" Color="#69C182" />
                    <SolidColorBrush x:Key="IconCaptureBrush" Color="#6FB2F0" />
                    <SolidColorBrush x:Key="IconMeasureBrush" Color="#B79BE0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <!--  En alto contraste manda el sistema: nada de tintes propios.  -->
                    <SolidColorBrush x:Key="IconRevisionBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="IconHighlightBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="IconInkBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="IconSignatureBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="IconSaveBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="IconCaptureBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="IconMeasureBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
