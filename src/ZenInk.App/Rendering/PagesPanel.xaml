<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ZenInk_App.Rendering.PagesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZenInk_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            El panel no ve los recursos de la página, así que trae los suyos.
            Iconos de 18 px, y los botones sin relleno lateral: con ancho fijo,
            el relleno recorta el dibujo en vez de encogerlo.
        -->
        <Style x:Key="PanelIconStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Thickness" Value="1.55" />
        </Style>

        <!--
            Seis controles en un panel de 232: cada punto de relleno lateral
            cuenta, así que no llevan ninguno. Con ancho fijo, el relleno
            recorta el dibujo en vez de encogerlo.
        -->
        <Style x:Key="PanelIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelDropDownStyle" TargetType="DropDownButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="PanelTabStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0"
        RowDefinitions="40,*,Auto">

        <!--
            Dos vistas del mismo documento: las hojas y el índice que trae el
            archivo. El índice sólo aparece cuando hay uno; una pestaña vacía
            que no lleva a ninguna parte es peor que ninguna.
        -->
        <StackPanel
            Grid.Row="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <ToggleButton
                x:Name="SheetsTab"
                x:Uid="SheetsTab"
                Click="OnSheetsTabClicked"
                IsChecked="True"
                Style="{StaticResource PanelTabStyle}" />
            <ToggleButton
                x:Name="OutlineTab"
                x:Uid="OutlineTab"
                Click="OnOutlineTabClicked"
                Style="{StaticResource PanelTabStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <ListView
            x:Name="Sheets"
            Grid.Row="1"
            Padding="10,0,10,12"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsCompleted="OnSheetsReordered"
            SelectionChanged="OnSheetSelectionChanged"
            SelectionMode="Extended">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="rendering:PageThumbnail">
                    <Grid RowDefinitions="*,Auto">
                        <Border
                            Grid.Row="0"
                            Height="{x:Bind FrameHeight}"
                            Background="White"
                            BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                            BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                            CornerRadius="4">
                            <Grid>
                                <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#8A8A8A"
                                    Text="{x:Bind rendering:PageThumbnail.BlankLabel}"
                                    Visibility="{x:Bind BlankNote}" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="{x:Bind LabelWeight, Mode=OneWay}"
                            Foreground="{x:Bind LabelBrush, Mode=OneWay}"
                            Text="{x:Bind Number}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="Up"
                    Invoked="OnMoveUpAccelerator"
                    Modifiers="Menu" />
                <KeyboardAccelerator
                    Key="Down"
                    Invoked="OnMoveDownAccelerator"
                    Modifiers="Menu" />
            </ListView.KeyboardAccelerators>
            <ListView.ContextFlyout>
                <MenuFlyout Opening="OnSheetMenuOpening">
                    <MenuFlyoutItem
                        x:Name="MenuMoveUp"
                        x:Uid="MenuMoveUp"
                        Click="OnMoveUpClicked">
                        <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Alt+↑</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="MenuMoveDown"
                        x:Uid="MenuMoveDown"
                        Click="OnMoveDownClicked">
                        <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Alt+↓</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                    </MenuFlyoutItem>
                    <!--
                        En un juego de doscientas hojas, subir de una en una no
                        es una forma de llegar a la 7: hay que poder decir el
                        número y ya está.
                    -->
                    <MenuFlyoutItem
                        x:Name="MenuMoveTo"
                        x:Uid="MenuMoveTo"
                        Click="OnMoveToClicked" />

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem
                        x:Name="MenuRotateLeft"
                        x:Uid="MenuRotateLeft"
                        Click="OnRotateLeftClicked" />
                    <MenuFlyoutItem
                        x:Name="MenuRotateRight"
                        x:Uid="MenuRotateRight"
                        Click="OnRotateRightClicked" />

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem
                        x:Name="MenuDuplicate"
                        x:Uid="MenuDuplicate"
                        Click="OnDuplicateClicked" />
                    <MenuFlyoutItem
                        x:Name="MenuDelete"
                        x:Uid="MenuDelete"
                        Click="OnDeleteClicked" />

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem
                        x:Name="MenuInsertFile"
                        x:Uid="MenuInsertFile"
                        Click="OnInsertFromFileClicked" />
                    <MenuFlyoutItem
                        x:Name="MenuInsertBlank"
                        x:Uid="MenuInsertBlank"
                        Click="OnInsertBlankClicked" />

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem
                        x:Name="MenuExtract"
                        x:Uid="MenuExtract"
                        Click="OnExtractClicked" />
                    <MenuFlyoutItem
                        x:Name="MenuSplit"
                        x:Uid="MenuSplit"
                        Click="OnSplitClicked" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <TreeView
            x:Name="Outline"
            Grid.Row="1"
            Padding="6,0,6,12"
            ItemInvoked="OnOutlineInvoked"
            SelectionMode="Single"
            Visibility="Collapsed">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="rendering:OutlineNode">
                    <TreeViewItem
                        Content="{x:Bind Title}"
                        IsExpanded="True"
                        ItemsSource="{x:Bind Children}" />
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!--
            Lo que se hace a menudo, a un clic; lo demás en el menú del botón
            derecho. Todo se apaga cuando no hay hojas marcadas, porque un
            botón que no sabe sobre qué actuar no debería ofrecerse.
        -->
        <Grid
            x:Name="Actions"
            Grid.Row="2"
            Padding="4,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="1">
                <DropDownButton
                    x:Name="InsertButton"
                    x:Uid="InsertButton"
                    Style="{StaticResource PanelDropDownStyle}">
                    <!--  Una hoja con un más al lado: añadir papel al documento.  -->
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M3.2 2.6h6.4l2.6 2.6v9.4H3.2Z M9.6 2.6v2.6h2.6 M14.6 11.4v5.8 M11.7 14.3h5.8" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem x:Uid="PanelInsertFromFile" Click="OnInsertFromFileClicked" />
                            <MenuFlyoutItem x:Uid="PanelInsertBlank" Click="OnInsertBlankClicked" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Rectangle
                    Width="1"
                    Height="18"
                    Margin="3,0"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button
                    x:Name="MoveUpButton"
                    x:Uid="MoveUpButton"
                    Click="OnMoveUpClicked"
                    Style="{StaticResource PanelIconButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M10 15.4V4.6 M5.4 9.2 L10 4.6 L14.6 9.2" />
                </Button>
                <Button
                    x:Name="MoveDownButton"
                    x:Uid="MoveDownButton"
                    Click="OnMoveDownClicked"
                    Style="{StaticResource PanelIconButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M10 4.6v10.8 M5.4 10.8 L10 15.4 L14.6 10.8" />
                </Button>
                <Button
                    x:Name="RotateLeftButton"
                    x:Uid="RotateLeftButton"
                    Click="OnRotateLeftClicked"
                    Style="{StaticResource PanelIconButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M10 3.8 A6.2 6.2 0 1 0 16.2 10 M18.1 12.2 L16.2 10 L14.3 12.2" />
                </Button>
                <Button
                    x:Name="RotateRightButton"
                    x:Uid="RotateRightButton"
                    Click="OnRotateRightClicked"
                    Style="{StaticResource PanelIconButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M10 3.8 A6.2 6.2 0 1 1 3.8 10 M1.9 12.2 L3.8 10 L5.7 12.2" />
                </Button>
                <Button
                    x:Name="DuplicateButton"
                    x:Uid="DuplicateButton"
                    Click="OnDuplicateClicked"
                    Style="{StaticResource PanelIconButtonStyle}">
                    <!--  Dos hojas, una detrás de otra.  -->
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M6.6 2.8h6.2l3 3v8.6H6.6Z M12.8 2.8v3h3 M13 14.4v2.8H3.8V6.4h2.8" />
                </Button>
                <Button
                    x:Name="DeleteButton"
                    x:Uid="DeleteButton"
                    Click="OnDeleteClicked"
                    Style="{StaticResource PanelIconButtonStyle}">
                    <!--  Papelera: tapa, cuerpo y dos rayas dentro.  -->
                    <controls:ToolIcon Style="{StaticResource PanelIconStyle}" Data="M3.4 5.4h13.2 M8 5.4V3.4h4v2 M5.2 5.4l0.9 11.2h7.8l0.9-11.2 M8.4 8.4v5.4 M11.6 8.4v5.4" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
