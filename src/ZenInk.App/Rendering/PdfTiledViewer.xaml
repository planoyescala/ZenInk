<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ZenInk_App.Rendering.PdfTiledViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:ZenInk_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllAccelerator" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <!--  Square icon buttons: no side padding, or the drawing gets cut rather than scaled.  -->
        <Style x:Key="FindButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FindToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FindIconStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Thickness" Value="1.6" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
        <canvas:CanvasControl
            x:Name="Canvas"
            Grid.Row="0"
            Grid.Column="0"
            ClearColor="Transparent"
            IsTabStop="True"
            Draw="OnDraw"
            KeyDown="OnCanvasKeyDown"
            SizeChanged="OnCanvasSizeChanged"
            PointerWheelChanged="OnPointerWheelChanged"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCanceled="OnPointerReleased"
            DoubleTapped="OnCanvasDoubleTapped" />

        <!--
            El cuadro para escribir directamente sobre la hoja. Flota en la
            misma celda que el lienzo y se coloca por su margen: darle una fila
            propia movería el dibujo justo cuando el lector va a escribir.

            Conserva su aspecto de cuadro de texto de Windows a propósito. Se
            podría teñir del color de la marca, pero la plantilla del control
            repinta fondo y texto al enfocarlo, así que solo se parecería a
            medias — y un editor que casi imita al resultado se lee como un
            fallo. Lo que sí hereda es el tipo y el cuerpo, que es lo que dice
            cuánto sitio va a ocupar el rótulo.
        -->
        <TextBox
            x:Name="WriteBox"
            Grid.Row="0"
            Grid.Column="0"
            MinWidth="52"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AcceptsReturn="True"
            FontFamily="Arial"
            KeyDown="OnWriteBoxKeyDown"
            TextChanged="OnWriteBoxTextChanged"
            TextWrapping="NoWrap"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0" />

        <primitives:ScrollBar
            x:Name="VerticalScroll"
            Grid.Row="0"
            Grid.Column="1"
            IndicatorMode="MouseIndicator"
            Minimum="0"
            Orientation="Vertical"
            Scroll="OnVerticalScroll"
            Visibility="Collapsed" />

        <primitives:ScrollBar
            x:Name="HorizontalScroll"
            Grid.Row="1"
            Grid.Column="0"
            IndicatorMode="MouseIndicator"
            Minimum="0"
            Orientation="Horizontal"
            Scroll="OnHorizontalScroll"
            Visibility="Collapsed" />

        <!--
            The find bar floats over the sheet rather than taking a row of its
            own: opening it must not reflow the drawing the reader is looking at.
        -->
        <Border
            x:Name="FindBar"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,10,10,0"
            Padding="8,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:ToolIcon
                    Width="15"
                    Height="15"
                    Margin="4,0,2,0"
                    VerticalAlignment="Center"
                    Data="M9 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z M13.4 13.4 17 17"
                    Opacity="0.5"
                    Thickness="1.5" />

                <TextBox
                    x:Name="FindInput"
                    x:Uid="FindInput"
                    Width="196"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    KeyDown="OnFindInputKeyDown"
                    TextChanged="OnFindTextChanged" />

                <TextBlock
                    x:Name="FindCount"
                    MinWidth="58"
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextAlignment="Center" />

                <ToggleButton
                    x:Name="FindMatchCase"
                    x:Uid="FindMatchCase"
                    Click="OnFindOptionChanged"
                    Style="{StaticResource FindToggleStyle}">
                    <TextBlock FontSize="12" Text="Aa" />
                </ToggleButton>
                <ToggleButton
                    x:Name="FindWholeWord"
                    x:Uid="FindWholeWord"
                    Click="OnFindOptionChanged"
                    Style="{StaticResource FindToggleStyle}">
                    <TextBlock FontSize="12" Text="ab" TextDecorations="Underline" />
                </ToggleButton>

                <Rectangle
                    Width="1"
                    Height="16"
                    Margin="3,0"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button
                    x:Name="FindPreviousButton"
                    x:Uid="FindPreviousButton"
                    Click="OnFindPreviousClicked"
                    Style="{StaticResource FindButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource FindIconStyle}" Data="M4.6 10.2 L8 6.8 L11.4 10.2" />
                </Button>
                <Button
                    x:Name="FindNextButton"
                    x:Uid="FindNextButton"
                    Click="OnFindNextClicked"
                    Style="{StaticResource FindButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource FindIconStyle}" Data="M4.6 6.8 L8 10.2 L11.4 6.8" />
                </Button>
                <Button
                    x:Name="FindCloseButton"
                    x:Uid="FindCloseButton"
                    Click="OnFindCloseClicked"
                    Style="{StaticResource FindButtonStyle}">
                    <controls:ToolIcon Style="{StaticResource FindIconStyle}" Data="M5 5 L11 11 M11 5 L5 11" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
