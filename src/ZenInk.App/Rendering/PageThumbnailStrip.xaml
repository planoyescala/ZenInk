<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ZenInk_App.Rendering.PageThumbnailStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0"
        RowDefinitions="40,*">
        <TextBlock
            Grid.Row="0"
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Opacity="0.62"
            Text="HOJAS" />

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            Padding="0,0,0,14"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="OnScrollViewChanged">
            <ItemsRepeater
                x:Name="Repeater"
                Margin="14,0"
                ElementPrepared="OnElementPrepared">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="rendering:PageThumbnail">
                        <Grid
                            Padding="0,0,0,4"
                            RowDefinitions="*,Auto"
                            Tapped="OnThumbnailTapped">
                            <Border
                                Grid.Row="0"
                                Height="{x:Bind FrameHeight, Mode=OneWay}"
                                Background="White"
                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                CornerRadius="4">
                                <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="{x:Bind LabelWeight, Mode=OneWay}"
                                Foreground="{x:Bind LabelBrush, Mode=OneWay}"
                                Text="{x:Bind Number}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
