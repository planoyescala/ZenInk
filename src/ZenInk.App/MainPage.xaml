<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ZenInk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZenInk_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZenInk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--
            A hairline stroke all but vanishes once WinUI dims a disabled
            control to ~36% opacity, which is most of this bar's resting state,
            so the icons carry more weight than the 20px grid would suggest.
        -->
        <Style x:Key="BarIconStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Thickness" Value="1.55" />
        </Style>

        <Style x:Key="BarIconBoldStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Thickness" Value="1.75" />
        </Style>

        <Style x:Key="RailIconStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Thickness" Value="1.5" />
        </Style>

        <!--  Raíl: botón cuadrado, icono solo.  -->
        <Style x:Key="RailToolStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlimButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!--
            Icon-only buttons carry no padding of their own: a fixed width plus
            side padding leaves the icon less room than it asks for, and the
            glyph is then clipped down its middle rather than shrunk.
        -->
        <Style x:Key="SlimIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlimToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="SlimDropDownStyle" TargetType="DropDownButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="SlimSplitButtonStyle" TargetType="SplitButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <!--
        The shortcuts live on the page, not on the menu items that name them: a
        flyout's items are only in the visual tree while the flyout is open, so
        an accelerator declared there would work only when the menu is already
        showing. The items carry the text; the page carries the keys.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
        <KeyboardAccelerator Key="F3" Invoked="OnFindNextAccelerator" />
        <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="OnFindPreviousAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnFitWidthAccelerator" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnFitPageAccelerator" />
        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnActualSizeAccelerator" />
        <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPrintAccelerator" />
    </Page.KeyboardAccelerators>

    <!--
        Dropping a drawing on the window opens it. A reviewer arrives with the
        sheets already in a folder in front of them, so making them go find the
        same file again through a picker is a step for nothing.
    -->
    <Grid
        AllowDrop="True"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop"
        RowDefinitions="Auto,Auto,*">

        <!--  Pestañas, sobre la línea de la barra de título  -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            AddTabButtonClick="OnAddTabClicked"
            IsAddTabButtonVisible="True"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="SizeToContent">
            <TabView.TabStripHeader>
                <!--  Marca dibujada, no un recurso de imagen: así sigue al tema y no depende de una ruta.  -->
                <Grid Width="42" Padding="13,0,0,0">
                    <Border
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4">
                        <controls:ToolIcon
                            Width="18"
                            Height="18"
                            Data="M6.6 7.4 L13.4 7.4 L6.6 12.6 L13.4 12.6"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Thickness="1.6" />
                    </Border>
                </Grid>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <!--  Zona de arrastre; su ancho deja hueco a los botones de la ventana.  -->
                <Grid x:Name="TitleBarDragRegion" />
            </TabView.TabStripFooter>
        </TabView>

        <!--  Barra slim: solo documento y vista. Las herramientas viven en el raíl.  -->
        <Grid
            Grid.Row="1"
            Height="44"
            Padding="12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1"
            ColumnDefinitions="Auto,*,Auto">

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="2">

                <Button
                    x:Name="OpenButton"
                    Click="OnOpenClicked"
                    Style="{StaticResource SlimButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.5 5.5A1.5 1.5 0 0 1 4 4h3.4l1.6 2H16a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 16 16H4a1.5 1.5 0 0 1-1.5-1.5Z" />
                        <TextBlock Text="Abrir" />
                    </StackPanel>
                </Button>

                <!--
                    Saving sits beside opening because that is what it is: the
                    other half of the document's own life, not an afterthought
                    of whichever tool happened to change something. Today only
                    the sheet turns reach it; comments will arrive here too, and
                    the control does not have to move when they do.
                -->
                <SplitButton
                    x:Name="SaveButton"
                    Click="OnSaveClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimSplitButtonStyle}"
                    ToolTipService.ToolTip="Guardar los cambios en el PDF (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 3.4v8.4 M6.4 8.4 L10 12 L13.6 8.4 M3.6 13.2v2.2a1.2 1.2 0 0 0 1.2 1.2h10.4a1.2 1.2 0 0 0 1.2-1.2v-2.2" />
                        <TextBlock Text="Guardar" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem
                                x:Name="SaveItem"
                                Click="OnSaveItemClicked"
                                KeyboardAcceleratorTextOverride="Ctrl+S"
                                Text="Guardar en el PDF" />
                            <MenuFlyoutItem
                                x:Name="SaveCopyItem"
                                Click="OnSaveCopyClicked"
                                Text="Guardar como…" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <!--
                    One menu for the three questions that together answer "how
                    do I want to see this": how the sheets flow, how many sit
                    side by side, and what the zoom follows. They used to be
                    separate toggles, which said nothing about how they combine.
                -->
                <DropDownButton
                    x:Name="ViewModeButton"
                    IsEnabled="False"
                    Style="{StaticResource SlimDropDownStyle}"
                    ToolTipService.ToolTip="Cómo se ve el documento">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.8 3.6h14.4v12.8H2.8Z M10 3.6v12.8" />
                        <TextBlock x:Name="ViewModeText" Text="Vista" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <RadioMenuFlyoutItem
                                x:Name="FitWidthItem"
                                Click="OnFitWidthClicked"
                                GroupName="ZenInkFit"
                                KeyboardAcceleratorTextOverride="Ctrl+1"
                                Text="Ancho completo" />
                            <RadioMenuFlyoutItem
                                x:Name="FitPageItem"
                                Click="OnFitPageClicked"
                                GroupName="ZenInkFit"
                                KeyboardAcceleratorTextOverride="Ctrl+2"
                                Text="Página completa" />
                            <RadioMenuFlyoutItem
                                x:Name="FitActualItem"
                                Click="OnActualSizeClicked"
                                GroupName="ZenInkFit"
                                KeyboardAcceleratorTextOverride="Ctrl+0"
                                Text="Tamaño real (100 %)" />
                            <RadioMenuFlyoutItem
                                x:Name="FitFreeItem"
                                Click="OnFitFreeClicked"
                                GroupName="ZenInkFit"
                                Text="Zoom libre" />

                            <MenuFlyoutSeparator />

                            <RadioMenuFlyoutItem
                                x:Name="OneColumnItem"
                                Click="OnOneColumnClicked"
                                GroupName="ZenInkColumns"
                                Text="A una página" />
                            <RadioMenuFlyoutItem
                                x:Name="TwoColumnsItem"
                                Click="OnTwoColumnsClicked"
                                GroupName="ZenInkColumns"
                                Text="A dos páginas" />

                            <MenuFlyoutSeparator />

                            <RadioMenuFlyoutItem
                                x:Name="ContinuousItem"
                                Click="OnContinuousModeClicked"
                                GroupName="ZenInkFlow"
                                Text="Continuo — todas las hojas en una tira" />
                            <RadioMenuFlyoutItem
                                x:Name="SingleItem"
                                Click="OnSingleModeClicked"
                                GroupName="ZenInkFlow"
                                Text="Hoja a hoja — la rueda hace zoom" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton
                    x:Name="RotateButton"
                    IsEnabled="False"
                    Style="{StaticResource SlimDropDownStyle}"
                    ToolTipService.ToolTip="Girar hojas">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <!--
                            Three quarters of a circle, drawn clockwise from
                            the top, with the head on the end it actually
                            arrives at. Pointing the head the other way — or
                            giving it barbs as long as the radius — closes the
                            gap and the whole thing reads as a filled blob at
                            18px.
                        -->
                        <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 3.8 A6.2 6.2 0 1 1 3.8 10 M1.9 12.2 L3.8 10 L5.7 12.2" />
                        <TextBlock Text="Girar" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Click="OnRotateLeftClicked" Text="Girar la hoja a la izquierda" />
                            <MenuFlyoutItem Click="OnRotateRightClicked" Text="Girar la hoja a la derecha" />

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem Click="OnRotateAllLeftClicked" Text="Girar todas las hojas a la izquierda" />
                            <MenuFlyoutItem Click="OnRotateAllRightClicked" Text="Girar todas las hojas a la derecha" />

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem
                                x:Name="DiscardRotationsItem"
                                Click="OnDiscardRotationsClicked"
                                Text="Descartar los giros sin guardar" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button
                    x:Name="PreviousPageButton"
                    Click="OnPreviousPageClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Hoja anterior">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M5.5 12.25 L10 7.75 L14.5 12.25" />
                </Button>
                <TextBlock
                    x:Name="PageIndicator"
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Opacity="0.7" />
                <Button
                    x:Name="NextPageButton"
                    Click="OnNextPageClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Hoja siguiente">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M5.5 7.75 L10 12.25 L14.5 7.75" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <ToggleButton
                    x:Name="LineWeightButton"
                    Click="OnLineWeightClicked"
                    IsChecked="True"
                    IsEnabled="False"
                    Style="{StaticResource SlimToggleStyle}"
                    ToolTipService.ToolTip="Grosores de línea — desactivar dibuja todas las líneas finas">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <controls:ToolIcon
                            Style="{StaticResource BarIconStyle}"
                            Data="M3 4.5h14v1.1H3Z M3 8.9h14v2.2H3Z M3 14.1h14v3.4H3Z"
                            Filled="True" />
                        <TextBlock Text="Grosores" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <TextBlock
                x:Name="DocumentNameText"
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                Opacity="0.55"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="PrintButton"
                    Click="OnPrintClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Imprimir (Ctrl+P)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M6 7.4V3.2h8v4.2 M6 13.4H4.4a1.4 1.4 0 0 1-1.4-1.4V8.8a1.4 1.4 0 0 1 1.4-1.4h11.2a1.4 1.4 0 0 1 1.4 1.4V12a1.4 1.4 0 0 1-1.4 1.4H14 M6 11.6h8v5.2H6Z" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button
                    x:Name="FindButton"
                    Click="OnFindClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Buscar en el documento (Ctrl+F)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M9 15.4a6.4 6.4 0 1 0 0-12.8 6.4 6.4 0 0 0 0 12.8Z M13.6 13.6 17.2 17.2" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button
                    x:Name="ZoomOutButton"
                    Click="OnZoomOutClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Alejar">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M4.8 10 L15.2 10" />
                </Button>
                <TextBlock
                    x:Name="ZoomIndicator"
                    MinWidth="52"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    TextAlignment="Center" />
                <Button
                    x:Name="ZoomInButton"
                    Click="OnZoomInClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Acercar">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M10 4.8 L10 15.2 M4.8 10 L15.2 10" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button
                    x:Name="SettingsButton"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Preferencias">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 12.6a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Z M15.9 12.6a1.4 1.4 0 0 0 .3 1.6l.1.1a1.7 1.7 0 1 1-2.4 2.4l-.1-.1a1.4 1.4 0 0 0-1.6-.3 1.4 1.4 0 0 0-.9 1.3v.2a1.7 1.7 0 1 1-3.4 0v-.1a1.4 1.4 0 0 0-.9-1.3 1.4 1.4 0 0 0-1.6.3l-.1.1a1.7 1.7 0 1 1-2.4-2.4l.1-.1a1.4 1.4 0 0 0 .3-1.6 1.4 1.4 0 0 0-1.3-.9h-.2a1.7 1.7 0 1 1 0-3.4h.1a1.4 1.4 0 0 0 1.3-.9 1.4 1.4 0 0 0-.3-1.6l-.1-.1a1.7 1.7 0 1 1 2.4-2.4l.1.1a1.4 1.4 0 0 0 1.6.3h.1a1.4 1.4 0 0 0 .9-1.3v-.2a1.7 1.7 0 1 1 3.4 0v.1a1.4 1.4 0 0 0 .9 1.3 1.4 1.4 0 0 0 1.6-.3l.1-.1a1.7 1.7 0 1 1 2.4 2.4l-.1.1a1.4 1.4 0 0 0-.3 1.6v.1a1.4 1.4 0 0 0 1.3.9h.2a1.7 1.7 0 1 1 0 3.4h-.1a1.4 1.4 0 0 0-1.3.9Z" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutSubItem Text="Tema">
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeSystemItem"
                                    Click="OnThemeSystemClicked"
                                    GroupName="AppTheme"
                                    Text="Según el sistema" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeLightItem"
                                    Click="OnThemeLightClicked"
                                    GroupName="AppTheme"
                                    Text="Claro" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeDarkItem"
                                    Click="OnThemeDarkClicked"
                                    GroupName="AppTheme"
                                    Text="Oscuro" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Cuerpo: raíl · miniaturas · lienzo · propiedades  -->
        <Grid Grid.Row="2" ColumnDefinitions="56,Auto,*,Auto">

            <!--  Raíl de herramientas  -->
            <Grid
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                RowDefinitions="Auto,*,Auto">
                <StackPanel
                    Grid.Row="0"
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Spacing="3">
                    <ToggleButton
                        x:Name="PanToolButton"
                        Click="OnPanToolClicked"
                        IsChecked="True"
                        IsEnabled="False"
                        Style="{StaticResource RailToolStyle}"
                        ToolTipService.Placement="Right"
                        ToolTipService.ToolTip="Mano — arrastrar para desplazar">
                        <controls:ToolIcon Style="{StaticResource RailIconStyle}" Data="M7 9V4.6a1.1 1.1 0 0 1 2.2 0V9 M9.2 8.4V3.8a1.1 1.1 0 0 1 2.2 0v4.6 M11.4 8.1V5.3a1.1 1.1 0 0 1 2.2 0V11 M4.8 9.4a1.1 1.1 0 0 1 2.2 0v2.2 M4.8 11.6c0 3 2.2 5.4 5.2 5.4s5.4-2 5.4-5.4V8" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ZoomToolButton"
                        Click="OnZoomToolClicked"
                        IsEnabled="False"
                        Style="{StaticResource RailToolStyle}"
                        ToolTipService.Placement="Right"
                        ToolTipService.ToolTip="Zoom por ventana — arrastra un rectángulo sobre la zona">
                        <controls:ToolIcon Style="{StaticResource RailIconStyle}" Data="M8.6 14.6a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z M13 13 17.2 17.2 M6.2 8.6h4.8 M8.6 6.2v4.8" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="TextToolButton"
                        Click="OnTextToolClicked"
                        IsEnabled="False"
                        Style="{StaticResource RailToolStyle}"
                        ToolTipService.Placement="Right"
                        ToolTipService.ToolTip="Seleccionar texto">
                        <controls:ToolIcon Style="{StaticResource RailIconStyle}" Data="M8 3.5h4 M8 16.5h4 M10 3.5v13" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Padding="0,8"
                    HorizontalAlignment="Center">
                    <ToggleButton
                        x:Name="ThumbnailsButton"
                        Click="OnThumbnailsClicked"
                        IsEnabled="False"
                        Style="{StaticResource RailToolStyle}"
                        ToolTipService.Placement="Right"
                        ToolTipService.ToolTip="Miniaturas de hojas">
                        <controls:ToolIcon Style="{StaticResource RailIconStyle}" Data="M2.8 3.6h6v6h-6Z M11.2 3.6h6v6h-6Z M2.8 11.4h6v6h-6Z M11.2 11.4h6v6h-6Z" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!--  Miniaturas  -->
            <rendering:PageThumbnailStrip
                x:Name="Thumbnails"
                Grid.Column="1"
                Width="196"
                Visibility="Collapsed" />

            <!--  Lienzo  -->
            <Grid Grid.Column="2">
                <!--  Las pestañas son solo la tira; el visor de la activa se aloja aquí.  -->
                <ContentControl
                    x:Name="ViewerPresenter"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <controls:ToolIcon
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Data="M5 3.4h6l4 4v9.2H5Z M11 3.4v4h4"
                        Opacity="0.32"
                        Thickness="1" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.55"
                        Text="Abre un plano para empezar" />
                </StackPanel>
            </Grid>

            <!--  Propiedades de la herramienta activa  -->
            <Grid
                x:Name="PropertiesPanel"
                Grid.Column="3"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                RowDefinitions="46,*"
                Visibility="Collapsed">

                <StackPanel
                    Grid.Row="0"
                    Padding="16,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Orientation="Horizontal"
                    Spacing="10">
                    <controls:ToolIcon
                        Width="15"
                        Height="15"
                        VerticalAlignment="Center"
                        Data="M8 3.5h4 M8 16.5h4 M10 3.5v13"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Selección de texto" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Padding="16,20"
                    Spacing="14">
                    <TextBlock
                        x:Name="SelectionStatus"
                        Opacity="0.6"
                        Text="Arrastra sobre el plano para seleccionar."
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="CopySelectionButton"
                        HorizontalAlignment="Stretch"
                        Click="OnCopySelectionClicked"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M7 2.8h8.2a1.4 1.4 0 0 1 1.4 1.4v8.2 M4.8 5.6h7.6a1.4 1.4 0 0 1 1.4 1.4v8.2a1.4 1.4 0 0 1-1.4 1.4H4.8a1.4 1.4 0 0 1-1.4-1.4V7a1.4 1.4 0 0 1 1.4-1.4Z" />
                            <TextBlock Text="Copiar" />
