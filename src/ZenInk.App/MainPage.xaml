<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ZenInk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZenInk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="48,*" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel
            Grid.Row="0"
            Padding="8,0"
            Orientation="Horizontal"
            Spacing="2">

            <Button x:Name="OpenButton" Click="OnOpenClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Abrir" />
                </StackPanel>
            </Button>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

            <ToggleButton
                x:Name="PanToolButton"
                Click="OnPanToolClicked"
                IsChecked="True"
                IsEnabled="False"
                ToolTipService.ToolTip="Mano — arrastrar para desplazar">
                <FontIcon Glyph="&#xE7C2;" FontSize="16" />
            </ToggleButton>
            <ToggleButton
                x:Name="TextToolButton"
                Click="OnTextToolClicked"
                IsEnabled="False"
                ToolTipService.ToolTip="Seleccionar texto">
                <FontIcon Glyph="&#xE8E9;" FontSize="16" />
            </ToggleButton>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

            <ToggleButton
                x:Name="ContinuousModeButton"
                Click="OnContinuousModeClicked"
                IsChecked="True"
                IsEnabled="False"
                ToolTipService.ToolTip="Vista continua — todas las hojas en una tira">
                <TextBlock Text="Continuo" />
            </ToggleButton>
            <ToggleButton
                x:Name="SingleModeButton"
                Click="OnSingleModeClicked"
                IsEnabled="False"
                ToolTipService.ToolTip="Hoja única — la rueda hace zoom, sin saltar de hoja">
                <TextBlock Text="Hoja" />
            </ToggleButton>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

            <Button
                x:Name="PreviousPageButton"
                Click="OnPreviousPageClicked"
                IsEnabled="False"
                ToolTipService.ToolTip="Hoja anterior">
                <FontIcon Glyph="&#xE70E;" FontSize="16" />
            </Button>
            <Button
                x:Name="NextPageButton"
                Click="OnNextPageClicked"
                IsEnabled="False"
                ToolTipService.ToolTip="Hoja siguiente">
                <FontIcon Glyph="&#xE70D;" FontSize="16" />
            </Button>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

            <Button
                x:Name="FitButton"
                Click="OnFitClicked"
                IsEnabled="False"
                ToolTipService.ToolTip="Ajustar al ancho">
                <FontIcon Glyph="&#xE9A6;" FontSize="16" />
            </Button>
        </StackPanel>

        <TextBlock
            x:Name="ViewStatusText"
            Grid.Row="0"
            Margin="0,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Opacity="0.7" />

        <TabView
            x:Name="Tabs"
            Grid.Row="1"
            AddTabButtonClick="OnAddTabClicked"
            IsAddTabButtonVisible="True"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="SizeToContent" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Glyph="&#xEA90;"
                Opacity="0.35" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.6"
                Text="Abre un plano para empezar" />
        </StackPanel>
    </Grid>
</Page>
