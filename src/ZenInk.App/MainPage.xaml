<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ZenInk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZenInk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    mc:Ignorable="d">

    <Grid RowDefinitions="48,*" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid Grid.Row="0" Padding="8,0" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" x:Name="OpenButton" Click="OnOpenClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Abrir" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="DocumentNameText"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Opacity="0.7"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <rendering:PdfTiledViewer x:Name="Viewer" Grid.Row="1" />
    </Grid>
</Page>
