<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ZenInk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZenInk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    mc:Ignorable="d">

    <Grid RowDefinitions="48,*" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid Grid.Row="0" Padding="8,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" x:Name="OpenButton" Click="OnOpenClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Abrir" />
                </StackPanel>
            </Button>

            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                Orientation="Horizontal"
                Spacing="2">
                <ToggleButton
                    x:Name="PanToolButton"
                    Click="OnPanToolClicked"
                    IsChecked="True"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Mano — arrastrar para desplazar">
                    <FontIcon Glyph="&#xE7C2;" FontSize="16" />
                </ToggleButton>
                <ToggleButton
                    x:Name="TextToolButton"
                    Click="OnTextToolClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Seleccionar texto (Ctrl+C para copiar)">
                    <FontIcon Glyph="&#xE8E9;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <Button
                Grid.Column="2"
                x:Name="FitButton"
                Margin="12,0,0,0"
                Click="OnFitClicked"
                IsEnabled="False"
                ToolTipService.ToolTip="Ajustar al ancho">
                <FontIcon Glyph="&#xE9A6;" FontSize="16" />
            </Button>

            <TextBlock
                x:Name="DocumentNameText"
                Grid.Column="3"
                Margin="12,0"
                VerticalAlignment="Center"
                Opacity="0.7"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="ViewStatusText"
                Grid.Column="4"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Opacity="0.7" />
        </Grid>

        <rendering:PdfTiledViewer x:Name="Viewer" Grid.Row="1" />
    </Grid>
</Page>
