<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ZenInk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZenInk_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZenInk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:ZenInk_App.Rendering"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--
            A hairline stroke all but vanishes once WinUI dims a disabled
            control to ~36% opacity, which is most of this bar's resting state,
            so the icons carry more weight than the 20px grid would suggest.
        -->
        <Style x:Key="BarIconStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Thickness" Value="1.55" />
        </Style>

        <Style x:Key="BarIconBoldStyle" TargetType="controls:ToolIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Thickness" Value="1.75" />
        </Style>


        <Style x:Key="SlimButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!--
            Icon-only buttons carry no padding of their own: a fixed width plus
            side padding leaves the icon less room than it asks for, and the
            glyph is then clipped down its middle rather than shrunk.
        -->
        <Style x:Key="SlimIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlimToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!--  Los cuatro modos fijos: nunca llevan rótulo, así que nunca cambian de ancho.  -->
        <Style x:Key="SlimIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlimDropDownStyle" TargetType="DropDownButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!--  Muestra de color: el botón no pinta nada, el color lo pone el borde de dentro.  -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="SlimSplitButtonStyle" TargetType="SplitButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <!--
        The shortcuts live on the page, not on the menu items that name them: a
        flyout's items are only in the visual tree while the flyout is open, so
        an accelerator declared there would work only when the menu is already
        showing. The items carry the text; the page carries the keys.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteAccelerator" />
        <KeyboardAccelerator Key="F3" Invoked="OnFindNextAccelerator" />
        <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="OnFindPreviousAccelerator" />

        <!--
            F4 junto a F3 a propósito: uno lleva al resultado siguiente y el
            otro al cambio siguiente, y son el mismo gesto sobre cosas
            distintas. Solo responden mientras hay una comparación puesta.
        -->
        <KeyboardAccelerator Key="F4" Invoked="OnNextChangeAccelerator" />
        <KeyboardAccelerator Key="F4" Modifiers="Shift" Invoked="OnPreviousChangeAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        <!--
            Supr belongs to the page and not to the canvas: picking a mark up
            and then reaching for its colour or its width leaves the caret in
            the panel, and a key that works only while the drawing itself holds
            focus reads as a key that does not work.
        -->
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnFitWidthAccelerator" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnFitPageAccelerator" />
        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnActualSizeAccelerator" />
        <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPrintAccelerator" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAccelerator" />
        <KeyboardAccelerator
            Key="Z"
            Invoked="OnRedoAccelerator"
            Modifiers="Control,Shift" />

        <!--
            Una letra por herramienta, sin modificador, como en cualquier CAD.
            Es lo que paga el único coste de la cinta: con la flecha a un
            golpe de tecla desde donde estés, que viva en la pestaña «Marcar»
            deja de importar. Van aquí y no en los botones porque el botón de
            una pestaña oculta no está en el árbol para atender la tecla.
        -->
        <KeyboardAccelerator Key="M" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="V" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="L" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="F" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="P" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="R" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="E" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="G" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="N" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="S" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="T" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="C" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="A" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="Z" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="X" Invoked="OnToolAccelerator" />
        <KeyboardAccelerator Key="K" Invoked="OnToolAccelerator" />
    </Page.KeyboardAccelerators>

    <!--
        Dropping a drawing on the window opens it. A reviewer arrives with the
        sheets already in a folder in front of them, so making them go find the
        same file again through a picker is a step for nothing.
    -->
    <Grid
        AllowDrop="True"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop"
        RowDefinitions="Auto,Auto,Auto,*">

        <!--
            Pestañas, sobre la línea de la barra de título, con el
            comportamiento de un navegador: todas del mismo ancho y encogiendo a
            medida que se abren más, en vez de crecer con el nombre del plano
            hasta que la tira se sale de la ventana. Como en Brave, la pestaña
            activa se funde con la barra de abajo: por eso esa barra ya no lleva
            línea por arriba.
        -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            AddTabButtonClick="OnAddTabClicked"
            IsAddTabButtonVisible="True"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="Equal">
            <TabView.TabStripHeader>
                <!--
                    El logo de la app, en el sitio donde un navegador pone el
                    suyo. Aquí sí es un mapa de bits y no geometría: es una
                    marca de identidad a todo color, no un icono que deba
                    seguir al tema. Va a 72 px y se reduce, para que a 200 % de
                    escala siga habiendo píxeles de sobra.
                -->
                <Grid Width="42" Padding="13,0,0,0">
                    <Image
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/AppMark.png" />
                </Grid>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <!--  Zona de arrastre; su ancho deja hueco a los botones de la ventana.  -->
                <Grid x:Name="TitleBarDragRegion" />
            </TabView.TabStripFooter>
        </TabView>

        <!--
            La cinta va en dos filas y no en una. La de arriba es fija: qué
            documento hay, deshacer, en qué hoja vas y a qué zoom. Eso es lo
            que no puede depender de en qué pestaña estés — si «página
            siguiente» viviera en «Hojas», pasar de hoja mientras marcas
            costaría un viaje de ida y vuelta. La de abajo es la que cambia.
        -->
        <Grid
            Grid.Row="1"
            Height="36"
            Padding="8,0,12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnDefinitions="Auto,*,Auto">

            <SelectorBar
                x:Name="RibbonTabs"
                Grid.Column="0"
                VerticalAlignment="Center"
                SelectionChanged="OnRibbonTabChanged">
                <SelectorBarItem
                    x:Name="TabInicio"
                    IsSelected="True"
                    Text="Inicio" />
                <SelectorBarItem x:Name="TabAnotar" Text="Anotar" />
                <SelectorBarItem x:Name="TabOrganizador" Text="Organizador" />
                <SelectorBarItem x:Name="TabComparar" Text="Comparar" />
                <SelectorBarItem x:Name="TabMedir" Text="Medir" />
            </SelectorBar>

            <TextBlock
                x:Name="DocumentNameText"
                Grid.Column="1"
                Margin="20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Opacity="0.55"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">

                <!--
                    Undo sits with the document's own actions, not with a tool:
                    it is the reader's way back from anything, and it must not
                    disappear when they change tab.
                -->
                <Button
                    x:Name="UndoButton"
                    Click="OnUndoClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Deshacer (Ctrl+Z)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M6.5 6.2 L3 9.7 L6.5 13.2 M3 9.7h8.2a4.6 4.6 0 0 1 0 9.2" />
                </Button>
                <Button
                    x:Name="RedoButton"
                    Click="OnRedoClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Rehacer (Ctrl+Y)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M13.5 6.2 L17 9.7 L13.5 13.2 M17 9.7H8.8a4.6 4.6 0 0 0 0 9.2" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button
                    x:Name="PreviousPageButton"
                    Click="OnPreviousPageClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Página anterior">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M5.5 12.25 L10 7.75 L14.5 12.25" />
                </Button>
                <TextBlock
                    x:Name="PageIndicator"
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Opacity="0.7" />
                <Button
                    x:Name="NextPageButton"
                    Click="OnNextPageClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Página siguiente">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M5.5 7.75 L10 12.25 L14.5 7.75" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button
                    x:Name="ZoomOutButton"
                    Click="OnZoomOutClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Alejar">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M4.8 10 L15.2 10" />
                </Button>
                <TextBlock
                    x:Name="ZoomIndicator"
                    MinWidth="52"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    TextAlignment="Center" />
                <Button
                    x:Name="ZoomInButton"
                    Click="OnZoomInClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconButtonStyle}"
                    ToolTipService.ToolTip="Acercar">
                    <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M10 4.8 L10 15.2 M4.8 10 L15.2 10" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Fila de comandos. A la izquierda, fuera de las pestañas, los cuatro
            modos de navegación: son a lo que se vuelve entre marca y marca, y
            meterlos en una pestaña obligaría a viajar hasta ella para soltar la
            herramienta. Van sin rótulo a propósito —la mano, la I del texto, la
            flecha y la lupa se reconocen solas— y así no se llevan el ancho que
            necesitan los nombres de los demás.

            A la derecha, la pestaña activa. Las tres viven a la vez en el árbol
            y solo se ve una: cambiar de pestaña no puede reconstruir botones
            cuyo estado —qué herramienta está pulsada— lo lleva el propio
            control.
        -->
        <Grid
            Grid.Row="2"
            Height="44"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="Auto,*">

            <StackPanel
                Grid.Column="0"
                Padding="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <ToggleButton
                    x:Name="PanToolButton"
                    Click="OnPanToolClicked"
                    IsChecked="True"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconToggleStyle}"
                    ToolTipService.ToolTip="Mano — arrastrar para desplazar (M)">
                    <!--
                        Una mano abierta y nada más. Los cuatro dedos se dibujan
                        encadenados —el lado derecho de uno es el izquierdo del
                        siguiente— porque a 18 px lo que los separa no son huecos
                        sino que el contorno baje entre bulto y bulto. Los altos
                        van escalonados como una mano de verdad: corazón el más
                        largo, meñique el más corto.
                    -->
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M7.2 10.6V5.0a1.15 1.15 0 0 1 2.3 0v3.4 M9.5 8.4V3.6a1.15 1.15 0 0 1 2.3 0v4.8 M11.8 8.4V4.0a1.15 1.15 0 0 1 2.3 0v4.4 M14.1 8.4V5.2a1.15 1.15 0 0 1 2.3 0v3.2a5 5 0 0 1-1.5 3.6 3 3 0 0 0-.9 2.2V16.8 M7.2 10.6 L5.9 8.9a1.35 1.35 0 0 0-2.2 1.6l2 3a5.4 5.4 0 0 0 .9 3V16.8" />
                </ToggleButton>
                <ToggleButton
                    x:Name="SelectMarkToolButton"
                    Click="OnSelectMarkToolClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconToggleStyle}"
                    ToolTipService.ToolTip="Seleccionar marcas — arrastrar para moverlas, Supr para borrar (V)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M5.6 3.2 L5.6 15.4 L8.6 12.6 L10.6 16.8 L12.8 15.8 L10.8 11.8 L15 11.6 Z" />
                </ToggleButton>
                <ToggleButton
                    x:Name="TextToolButton"
                    Click="OnTextToolClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconToggleStyle}"
                    ToolTipService.ToolTip="Seleccionar texto (X)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M8 3.5h4 M8 16.5h4 M10 3.5v13" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ZoomToolButton"
                    Click="OnZoomToolClicked"
                    IsEnabled="False"
                    Style="{StaticResource SlimIconToggleStyle}"
                    ToolTipService.ToolTip="Zoom por ventana — arrastra un rectángulo sobre la zona (Z)">
                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M8.6 14.6a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z M13 13 17.2 17.2 M6.2 8.6h4.8 M8.6 6.2v4.8" />
                </ToggleButton>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
            </StackPanel>

            <!--
                Cuando no cabe, los rótulos se van y quedan los iconos, que es
                lo que hace Office con la ventana estrecha. El desplazamiento
                lateral está debajo por si aun así no llega, pero no debería
                verse: una cinta con barra de desplazamiento es una cinta que ha
                fallado.
            -->
            <ScrollViewer
                x:Name="RibbonRow"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                SizeChanged="OnRibbonRowSizeChanged"
                VerticalScrollMode="Disabled">
                <Grid Padding="0,0,12,0">

                    <!--  Inicio: el documento, y cómo se mira.  -->
                    <StackPanel
                        x:Name="RibbonInicio"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">

                        <!--
                            El desplegable lleva los planos abiertos hace poco. Solo
                            guarda la ruta: nada se lee de los archivos para dibujar
                            esta lista, que es lo que la deja gratis al arrancar aunque
                            los planos estén en un servidor.
                        -->
                        <SplitButton
                            x:Name="OpenButton"
                            Click="OnOpenClicked"
                            Style="{StaticResource SlimSplitButtonStyle}"
                            ToolTipService.ToolTip="Abrir un documento">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.5 5.5A1.5 1.5 0 0 1 4 4h3.4l1.6 2H16a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 16 16H4a1.5 1.5 0 0 1-1.5-1.5Z" />
                                <TextBlock Text="Abrir" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout
                                    x:Name="RecentFlyout"
                                    Opening="OnRecentFlyoutOpening"
                                    Placement="BottomEdgeAlignedLeft" />
                            </SplitButton.Flyout>
                        </SplitButton>

                        <SplitButton
                            x:Name="SaveButton"
                            Click="OnSaveClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimSplitButtonStyle}"
                            ToolTipService.ToolTip="Guardar los cambios en el PDF (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  La flecha es la acción; la bandeja es el sitio donde cae.  -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconSaveBrush}"
                                    AccentData="M10 3.4v8.4 M6.4 8.4 L10 12 L13.6 8.4"
                                    Data="M3.6 13.2v2.2a1.2 1.2 0 0 0 1.2 1.2h10.4a1.2 1.2 0 0 0 1.2-1.2v-2.2" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem
                                        x:Name="SaveItem"
                                        Click="OnSaveItemClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+S"
                                        Text="Guardar en el PDF" />
                                    <MenuFlyoutItem
                                        x:Name="SaveCopyItem"
                                        Click="OnSaveCopyClicked"
                                        Text="Guardar como…" />

                                    <MenuFlyoutSeparator />

                                    <!--
                                        Descartar vive aquí, no en «Girar»: tira todo lo
                                        que no se ha escrito, marcas incluidas, y eso es
                                        asunto del documento y no de una herramienta.
                                    -->
                                    <MenuFlyoutItem
                                        x:Name="DiscardChangesItem"
                                        Click="OnDiscardChangesClicked"
                                        Text="Descartar los cambios sin guardar" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <!--
                            Aplanar y firmar son formas de guardar, no herramientas de
                            dibujo: escriben el archivo y cambian lo que el archivo es.
                            Por eso están junto a «Guardar» y no en «Anotar», aunque el
                            sello de la firma se coloque arrastrándolo como una marca.
                        -->
                        <Button
                            x:Name="FlattenButton"
                            Click="OnFlattenClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Aplanar las marcas en el documento (no se puede deshacer)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.6 4.6 L10 8 L16.4 4.6 M3.6 9 L10 12.4 L16.4 9 M3.6 16.4 H16.4" />
                                <TextBlock Text="Aplanar" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SignButton"
                            Click="OnSignClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Firmar el documento con un certificado">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  La rúbrica es tinta y el renglón es papel: solo la primera lleva color.  -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconSignatureBrush}"
                                    AccentData="M4.2 13.8 C 3.6 8.6, 6.2 4.2, 8.2 4.8 C 10 5.4, 9 9, 7.4 11.4 C 6.2 13.2, 7 14.2, 8.8 13.4 C 10.8 12.5, 12.6 10.6, 14.4 11 C 15.3 11.2, 15.6 12.2, 16.6 11.4"
                                    Data="M3.4 16.6 H16.6" />
                                <TextBlock Text="Firmar" />
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <Button
                            x:Name="PrintButton"
                            Click="OnPrintClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Imprimir (Ctrl+P)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M6 7.4V3.2h8v4.2 M6 13.4H4.4a1.4 1.4 0 0 1-1.4-1.4V8.8a1.4 1.4 0 0 1 1.4-1.4h11.2a1.4 1.4 0 0 1 1.4 1.4V12a1.4 1.4 0 0 1-1.4 1.4H14 M6 11.6h8v5.2H6Z" />
                                <TextBlock Text="Imprimir" />
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <!--
                            One menu for the three questions that together answer "how
                            do I want to see this": how the sheets flow, how many sit
                            side by side, and what the zoom follows.
                        -->
                        <DropDownButton
                            x:Name="ViewModeButton"
                            IsEnabled="False"
                            Style="{StaticResource SlimDropDownStyle}"
                            ToolTipService.ToolTip="Cómo se ve el documento">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.8 3.6h14.4v12.8H2.8Z M10 3.6v12.8" />
                                <TextBlock x:Name="ViewModeText" Text="Vista" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <RadioMenuFlyoutItem
                                        x:Name="FitWidthItem"
                                        Click="OnFitWidthClicked"
                                        GroupName="ZenInkFit"
                                        KeyboardAcceleratorTextOverride="Ctrl+1"
                                        Text="Ancho completo" />
                                    <RadioMenuFlyoutItem
                                        x:Name="FitPageItem"
                                        Click="OnFitPageClicked"
                                        GroupName="ZenInkFit"
                                        KeyboardAcceleratorTextOverride="Ctrl+2"
                                        Text="Página completa" />
                                    <RadioMenuFlyoutItem
                                        x:Name="FitActualItem"
                                        Click="OnActualSizeClicked"
                                        GroupName="ZenInkFit"
                                        KeyboardAcceleratorTextOverride="Ctrl+0"
                                        Text="Tamaño real (100 %)" />
                                    <RadioMenuFlyoutItem
                                        x:Name="FitFreeItem"
                                        Click="OnFitFreeClicked"
                                        GroupName="ZenInkFit"
                                        Text="Zoom libre" />

                                    <MenuFlyoutSeparator />

                                    <RadioMenuFlyoutItem
                                        x:Name="OneColumnItem"
                                        Click="OnOneColumnClicked"
                                        GroupName="ZenInkColumns"
                                        Text="A una página" />
                                    <RadioMenuFlyoutItem
                                        x:Name="TwoColumnsItem"
                                        Click="OnTwoColumnsClicked"
                                        GroupName="ZenInkColumns"
                                        Text="A dos páginas" />

                                    <MenuFlyoutSeparator />

                                    <RadioMenuFlyoutItem
                                        x:Name="ContinuousItem"
                                        Click="OnContinuousModeClicked"
                                        GroupName="ZenInkFlow"
                                        Text="Continuo — todas las páginas en una tira" />
                                    <RadioMenuFlyoutItem
                                        x:Name="SingleItem"
                                        Click="OnSingleModeClicked"
                                        GroupName="ZenInkFlow"
                                        Text="Página a página — la rueda hace zoom" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <ToggleButton
                            x:Name="LineWeightButton"
                            Click="OnLineWeightClicked"
                            IsChecked="True"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Grosores de línea — desactivar dibuja todas las líneas finas">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Data="M3 4.5h14v1.1H3Z M3 8.9h14v2.2H3Z M3 14.1h14v3.4H3Z"
                                    Filled="True" />
                                <TextBlock Text="Grosores" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <Button
                            x:Name="FindButton"
                            Click="OnFindClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Buscar en el documento (Ctrl+F)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M9 15.4a6.4 6.4 0 1 0 0-12.8 6.4 6.4 0 0 0 0 12.8Z M13.6 13.6 17.2 17.2" />
                                <TextBlock Text="Buscar" />
                            </StackPanel>
                        </Button>

                        <!--
                            El buscador de comandos necesita botón: un atajo que nadie
                            ve es un atajo que nadie usa. El icono es un cursor de
                            consola —el chevrón y su raya— porque es lo que significa
                            «escribe lo que quieras hacer», y no se confunde con la lupa
                            de al lado, que busca dentro del documento.
                        -->
                        <Button
                            x:Name="CommandButton"
                            Click="OnCommandButtonClicked"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Buscar una herramienta o una acción (Ctrl+K)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.8 4.6h14.4a1 1 0 0 1 1 1v8.8a1 1 0 0 1-1 1H2.8a1 1 0 0 1-1-1V5.6a1 1 0 0 1 1-1Z M5.6 8.2 L8 10.4 L5.6 12.6 M10 12.6h4.4" />
                                <TextBlock Text="Comandos" />
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <Button
                            x:Name="SettingsButton"
                            Style="{StaticResource SlimIconButtonStyle}"
                            ToolTipService.ToolTip="Preferencias">
                            <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 12.6a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Z M15.9 12.6a1.4 1.4 0 0 0 .3 1.6l.1.1a1.7 1.7 0 1 1-2.4 2.4l-.1-.1a1.4 1.4 0 0 0-1.6-.3 1.4 1.4 0 0 0-.9 1.3v.2a1.7 1.7 0 1 1-3.4 0v-.1a1.4 1.4 0 0 0-.9-1.3 1.4 1.4 0 0 0-1.6.3l-.1.1a1.7 1.7 0 1 1-2.4-2.4l.1-.1a1.4 1.4 0 0 0 .3-1.6 1.4 1.4 0 0 0-1.3-.9h-.2a1.7 1.7 0 1 1 0-3.4h.1a1.4 1.4 0 0 0 1.3-.9 1.4 1.4 0 0 0-.3-1.6l-.1-.1a1.7 1.7 0 1 1 2.4-2.4l.1.1a1.4 1.4 0 0 0 1.6.3h.1a1.4 1.4 0 0 0 .9-1.3v-.2a1.7 1.7 0 1 1 3.4 0v.1a1.4 1.4 0 0 0 .9 1.3 1.4 1.4 0 0 0 1.6-.3l.1-.1a1.7 1.7 0 1 1 2.4 2.4l-.1.1a1.4 1.4 0 0 0-.3 1.6v.1a1.4 1.4 0 0 0 1.3.9h.2a1.7 1.7 0 1 1 0 3.4h-.1a1.4 1.4 0 0 0-1.3.9Z" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutSubItem Text="Tema">
                                        <RadioMenuFlyoutItem
                                            x:Name="ThemeSystemItem"
                                            Click="OnThemeSystemClicked"
                                            GroupName="AppTheme"
                                            Text="Según el sistema" />
                                        <RadioMenuFlyoutItem
                                            x:Name="ThemeLightItem"
                                            Click="OnThemeLightClicked"
                                            GroupName="AppTheme"
                                            Text="Claro" />
                                        <RadioMenuFlyoutItem
                                            x:Name="ThemeDarkItem"
                                            Click="OnThemeDarkClicked"
                                            GroupName="AppTheme"
                                            Text="Oscuro" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <!--
                                        Windows no deja que un programa se ponga como
                                        predeterminado: esto lleva a la página donde se
                                        elige. Está aquí para quien dijo que no volviera
                                        a preguntar y luego cambió de idea.
                                    -->
                                    <MenuFlyoutItem
                                        x:Name="DefaultPdfItem"
                                        Click="OnDefaultPdfClicked"
                                        Text="Abrir los PDF con ZenInk…" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!--  Anotar: solo lo que deja algo dibujado en la hoja.  -->
                    <StackPanel
                        x:Name="RibbonAnotar"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="Collapsed">

                        <!--
                            La captura abre la pestaña porque es lo que se hace
                            con un plano revisado: recortar el detalle y pegarlo
                            en un correo. No deja nada en la hoja, así que va
                            separada del resto.
                        -->
                        <ToggleButton
                            x:Name="CaptureToolButton"
                            Click="OnCaptureToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Capturar una zona al portapapeles — arrastra un recuadro (K)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--
                                    Las cuatro esquinas de un encuadre y el disparador
                                    en medio. Sin cuerpo de cámara: a 18 px una cámara
                                    entera es una mancha, y lo que hay que leer aquí es
                                    «recorto un trozo», no «hago una foto».
                                -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconCaptureBrush}"
                                    AccentData="M8.2 10 H11.8 M10 8.2 V11.8"
                                    Data="M2.8 7 V4.2a1.4 1.4 0 0 1 1.4-1.4H7 M13 2.8h2.8a1.4 1.4 0 0 1 1.4 1.4V7 M17.2 13v2.8a1.4 1.4 0 0 1-1.4 1.4H13 M7 17.2H4.2a1.4 1.4 0 0 1-1.4-1.4V13" />
                                <TextBlock Text="Capturar" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <ToggleButton
                            x:Name="LineToolButton"
                            Click="OnLineToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Línea (L)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4 16 L16 4" />
                                <TextBlock Text="Línea" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ArrowToolButton"
                            Click="OnArrowToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Flecha (F)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4 16 L15.4 4.6 M10.2 4.6 H15.4 V9.8" />
                                <TextBlock Text="Flecha" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="PolylineToolButton"
                            Click="OnPolylineToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Polilínea — clic en cada vértice, Intro o doble clic para terminar (P)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.4 15.2 L7.6 6.6 L11.2 12.4 L16.6 4.8" />
                                <TextBlock Text="Polilínea" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <ToggleButton
                            x:Name="RectangleToolButton"
                            Click="OnRectangleToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Rectángulo (R)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.6 5.4h12.8v9.2H3.6Z" />
                                <TextBlock Text="Rectángulo" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="EllipseToolButton"
                            Click="OnEllipseToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Elipse (E)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 15.4c3.6 0 6.4-2.4 6.4-5.4S13.6 4.6 10 4.6 3.6 7 3.6 10s2.8 5.4 6.4 5.4Z" />
                                <TextBlock Text="Elipse" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="PolygonToolButton"
                            Click="OnPolygonToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Polígono — clic en cada vértice, Intro o doble clic para cerrarlo (G)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 3.2 L16.8 8.2 L14.2 16.4 H5.8 L3.2 8.2 Z" />
                                <TextBlock Text="Polígono" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="CloudToolButton"
                            Click="OnCloudToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Nube de revisión — arrastra un recuadro, o clic en cada vértice (N)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--
                                    Cuatro lóbulos y una base: a 18 px es lo que
                                    se lee como nube. Va entera de rojo —no una
                                    pieza suelta— porque una nube de revisión es
                                    roja en cualquier plano: aquí el color no
                                    decora, nombra.
                                -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconRevisionBrush}"
                                    AccentData="M5.6 15.2a2.7 2.7 0 0 1-.4-5.3 3.3 3.3 0 0 1 5.6-2.6 2.9 2.9 0 0 1 4.5 2.7 2.6 2.6 0 0 1-.5 5.2Z" />
                                <TextBlock Text="Nube" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <ToggleButton
                            x:Name="HighlightToolButton"
                            Click="OnHighlightToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Resaltar texto — arrastra sobre el texto (S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  La tinta va debajo del contorno, como en un rotulador de verdad.  -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconHighlightBrush}"
                                    AccentFill="M5.6 12.2 12.4 5.4l2.6 2.6-6.8 6.8H5.6Z"
                                    AccentFillOpacity="0.5"
                                    Data="M5.6 12.2 12.4 5.4l2.6 2.6-6.8 6.8H5.6Z M3.8 17.2h12.4" />
                                <TextBlock Text="Resaltar" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TextToolMarkButton"
                            Click="OnFreeTextToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Texto — clic en la página y se escribe al lado (T)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  Una A sobre una línea de base: el texto que se queda en el plano.  -->
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4.6 13.4 9 3.6h2L15.4 13.4 M6.6 10.2h6.8 M3.6 16.6h12.8" />
                                <TextBlock Text="Texto" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="NoteToolButton"
                            Click="OnNoteToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Comentario — clic en la página y se escribe al lado (C)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.8 5h12.4v8.2H9.4L6.2 16.4V13.2H3.8Z" />
                                <TextBlock Text="Comentario" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="InkToolButton"
                            Click="OnInkToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Lápiz — dibujar a mano alzada (A)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  Solo la punta lleva color: es la parte que pinta.  -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconInkBrush}"
                                    AccentFill="M4 16.2h3.4l3.2-3.2-3.4-3.4L4 12.8Z"
                                    AccentFillOpacity="0.62"
                                    Data="M4 16.2h3.4l8.8-8.8a1.7 1.7 0 0 0 0-2.4l-1-1a1.7 1.7 0 0 0-2.4 0L4 12.8Z M11.6 5.6 14.8 8.8" />
                                <TextBlock Text="Lápiz" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!--
                        Hojas: el juego de planos. Los mismos comandos que el panel,
                        pero alcanzables sin abrirlo — que es lo que la cinta vino a
                        arreglar. Sobre qué actúan lo decide `PagesPanel.Target()`: lo
                        marcado en el panel si hay algo marcado y el panel está a la
                        vista, y si no, la hoja en la que estás.
                    -->
                    <StackPanel
                        x:Name="RibbonOrganizador"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="Collapsed">
                        <ToggleButton
                            x:Name="ThumbnailsButton"
                            Click="OnThumbnailsClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Panel de hojas">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.8 3.6h6v6h-6Z M11.2 3.6h6v6h-6Z M2.8 11.4h6v6h-6Z M11.2 11.4h6v6h-6Z" />
                                <TextBlock Text="Panel" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <DropDownButton
                            x:Name="RotateButton"
                            IsEnabled="False"
                            Style="{StaticResource SlimDropDownStyle}"
                            ToolTipService.ToolTip="Girar páginas">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <!--
                                    Three quarters of a circle, drawn clockwise from
                                    the top, with the head on the end it actually
                                    arrives at. Pointing the head the other way — or
                                    giving it barbs as long as the radius — closes the
                                    gap and the whole thing reads as a filled blob at
                                    18px.
                                -->
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M10 3.8 A6.2 6.2 0 1 1 3.8 10 M1.9 12.2 L3.8 10 L5.7 12.2" />
                                <TextBlock Text="Girar" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Click="OnRotateLeftClicked" Text="Girar la página a la izquierda" />
                                    <MenuFlyoutItem Click="OnRotateRightClicked" Text="Girar la página a la derecha" />

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem Click="OnRotateAllLeftClicked" Text="Girar todas las páginas a la izquierda" />
                                    <MenuFlyoutItem Click="OnRotateAllRightClicked" Text="Girar todas las páginas a la derecha" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <DropDownButton
                            x:Name="InsertPagesButton"
                            IsEnabled="False"
                            Style="{StaticResource SlimDropDownStyle}"
                            ToolTipService.ToolTip="Insertar hojas detrás de la marcada">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4 3.4h8l3.6 3.6v9.6H4Z M12 3.4v3.6h3.6 M10 9.6v4.4 M7.8 11.8h4.4" />
                                <TextBlock Text="Insertar" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Click="OnInsertFromFileClicked" Text="Hojas de otro PDF…" />
                                    <MenuFlyoutItem Click="OnInsertBlankClicked" Text="Una hoja en blanco…" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button
                            x:Name="DuplicatePageButton"
                            Click="OnDuplicatePageClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Duplicar la hoja">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M7 2.8h8.2a1.4 1.4 0 0 1 1.4 1.4v8.2 M4.8 5.6h7.6a1.4 1.4 0 0 1 1.4 1.4v8.2a1.4 1.4 0 0 1-1.4 1.4H4.8a1.4 1.4 0 0 1-1.4-1.4V7a1.4 1.4 0 0 1 1.4-1.4Z" />
                                <TextBlock Text="Duplicar" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DeletePageButton"
                            Click="OnDeletePageClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Quitar la hoja del documento">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.6 5.6h12.8 M8 5.6V3.8h4v1.8 M5.4 5.6l.8 10.2a1 1 0 0 0 1 .9h5.6a1 1 0 0 0 1-.9l.8-10.2" />
                                <TextBlock Text="Quitar" />
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <Button
                            x:Name="ExtractPagesButton"
                            Click="OnExtractPagesClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Extraer las hojas a un PDF nuevo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4 3.4h6l3.6 3.6v4.4 M10 3.4v3.6h3.6 M4 3.4v13.2h5 M13 12.6v5.2 M10.8 15.6 L13 17.8 L15.2 15.6" />
                                <TextBlock Text="Extraer" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SplitPagesButton"
                            Click="OnSplitPagesClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Dividir el documento en archivos nuevos">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.4 3.6h5.2v5.2H3.4Z M11.4 3.6h5.2v5.2h-5.2Z M3.4 11.2h5.2v5.2H3.4Z M11.4 11.2h5.2v5.2h-5.2Z M10 1.8v16.4" />
                                <TextBlock Text="Dividir" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--
                        Comparar: la revisión anterior debajo de la que hay
                        abierta. Es una actividad y no una acción — se entra, se
                        recorren los cambios y se sale—, que es lo que le da
                        pestaña propia en vez de un botón escondido en un menú.

                        Elegir la revisión va primero porque sin ella el resto
                        no puede hacer nada, y los pasos entre cambios van justo
                        detrás porque son lo que se pulsa cuarenta veces.
                    -->
                    <StackPanel
                        x:Name="RibbonComparar"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="Collapsed">
                        <Button
                            x:Name="CompareOpenButton"
                            Click="OnCompareOpenClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Superponer otra revisión de este plano">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--
                                    Dos hojas superpuestas, y solo la de encima
                                    lleva color: es la revisión que se trae, y es
                                    del mismo rojo con que sale sobre el plano.
                                -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconRevisionBrush}"
                                    AccentData="M8.6 7.4h8v9.2h-8Z"
                                    Data="M3.4 3.4h8v9.2h-8Z" />
                                <TextBlock Text="Revisión…" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CompareStopButton"
                            Click="OnCompareStopClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Dejar de comparar y volver al plano">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M5.4 5.4 L14.6 14.6 M14.6 5.4 L5.4 14.6" />
                                <TextBlock Text="Salir" />
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <!--  Solo llevan dibujo, así que el nombre tiene que ir aparte.  -->
                        <Button
                            x:Name="PreviousChangeButton"
                            AutomationProperties.Name="Cambio anterior"
                            Click="OnPreviousChangeClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimIconButtonStyle}"
                            ToolTipService.ToolTip="Cambio anterior">
                            <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M12.25 5.5 L7.75 10 L12.25 14.5" />
                        </Button>
                        <TextBlock
                            x:Name="ChangeIndicator"
                            MinWidth="96"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            TextAlignment="Center" />
                        <Button
                            x:Name="NextChangeButton"
                            AutomationProperties.Name="Cambio siguiente"
                            Click="OnNextChangeClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimIconButtonStyle}"
                            ToolTipService.ToolTip="Cambio siguiente">
                            <controls:ToolIcon Style="{StaticResource BarIconBoldStyle}" Data="M7.75 5.5 L12.25 10 L7.75 14.5" />
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <DropDownButton
                            x:Name="ComparePairButton"
                            IsEnabled="False"
                            Style="{StaticResource SlimDropDownStyle}"
                            ToolTipService.ToolTip="Qué hoja de la revisión va con cuál">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.2 4.4h5v11.2h-5Z M11.8 4.4h5v11.2h-5Z M8.8 10h2.4" />
                                <TextBlock x:Name="ComparePairLabel" Text="Emparejar" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Click="OnComparePairBackClicked" Text="Atrasar la revisión una hoja" />
                                    <MenuFlyoutItem Click="OnComparePairForwardClicked" Text="Adelantar la revisión una hoja" />

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem Click="OnComparePairResetClicked" Text="Emparejar hoja con hoja" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <DropDownButton
                            x:Name="CompareFitButton"
                            IsEnabled="False"
                            Style="{StaticResource SlimDropDownStyle}"
                            ToolTipService.ToolTip="Cómo se coloca la revisión sobre la hoja">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M2.8 4h14.4v12H2.8Z M6.6 7.4h6.8v5.2H6.6Z" />
                                <TextBlock Text="Ajuste" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Click="OnCompareFitClicked" Text="Ajustar a la hoja, sin deformar" />
                                    <MenuFlyoutItem Click="OnCompareStretchClicked" Text="Estirar hasta llenar la hoja" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button
                            x:Name="CompareSwapButton"
                            Click="OnCompareSwapClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimButtonStyle}"
                            ToolTipService.ToolTip="Cambiar de color cada archivo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4.6 7.6h10.8 M12.8 5 L15.4 7.6 L12.8 10.2 M15.4 12.4H4.6 M7.2 9.8 L4.6 12.4 L7.2 15" />
                                <TextBlock Text="Colores" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--
                        Medir. Calibrar va primero y separado porque sin él el
                        resto no puede dar un número: una hoja sin calibrar no
                        sabe cuánto mide nada de lo que hay en ella. Los cuatro
                        que siguen son las medidas, en el orden en que se usan.
                    -->
                    <StackPanel
                        x:Name="RibbonMedir"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="Collapsed">

                        <ToggleButton
                            x:Name="CalibrateToolButton"
                            Click="OnCalibrateToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Calibrar la hoja — arrastra sobre una distancia conocida y di cuánto mide">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--
                                    Una regla: el trazo con sus marcas de
                                    graduación. El acento va en las marcas, que
                                    es lo que distingue una regla de una línea.
                                -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconMeasureBrush}"
                                    AccentData="M6 11.6V14 M10 10.4V14 M14 11.6V14"
                                    Data="M2.8 6h14.4v8H2.8Z" />
                                <TextBlock Text="Calibrar" />
                            </StackPanel>
                        </ToggleButton>

                        <TextBlock
                            x:Name="ScaleIndicator"
                            MinWidth="72"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            TextAlignment="Center" />

                        <ToggleButton
                            x:Name="SnapToolButton"
                            Click="OnSnapClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Pegar los puntos a las líneas del plano">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--
                                    Un punto sobre el cruce de dos líneas: eso
                                    es lo que hace, y a 18 px se lee sin
                                    nombrarlo.
                                -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconMeasureBrush}"
                                    AccentData="M10 7.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 1 0 0-4.8Z"
                                    Data="M3 10h14 M10 3v14" />
                                <TextBlock Text="Ajustar" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <ToggleButton
                            x:Name="DistanceToolButton"
                            Click="OnDistanceToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Distancia — arrastra de un punto a otro">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  Una línea de cota: el trazo y sus dos topes.  -->
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M4 10h12 M4 6.4v7.2 M16 6.4v7.2" />
                                <TextBlock Text="Distancia" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="PerimeterToolButton"
                            Click="OnPerimeterToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Perímetro — clic en cada vértice, Intro o doble clic para cerrar">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.6 13.4 L6.8 4.8 L12 8.6 L16.4 5.6 L14.6 15.2Z" />
                                <TextBlock Text="Perímetro" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="AreaToolButton"
                            Click="OnAreaToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Área — clic en cada vértice, Intro o doble clic para cerrar">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  La misma figura que el perímetro, con el interior teñido: eso es lo que las separa.  -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconMeasureBrush}"
                                    AccentData="M6.6 11.2 L8.2 7.4 L11.8 9.6 L13.4 12.6Z"
                                    Data="M3.6 13.4 L6.8 4.8 L12 8.6 L16.4 5.6 L14.6 15.2Z" />
                                <TextBlock Text="Área" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="AngleToolButton"
                            Click="OnAngleToolClicked"
                            IsEnabled="False"
                            Style="{StaticResource SlimToggleStyle}"
                            ToolTipService.ToolTip="Ángulo — un brazo, el vértice y el otro brazo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  Dos brazos y el arco entre ellos, que es como se acota un ángulo.  -->
                                <controls:ToolIcon
                                    Style="{StaticResource BarIconStyle}"
                                    Accent="{ThemeResource IconMeasureBrush}"
                                    AccentData="M9.4 15.2a6.4 6.4 0 0 0-3.6-3.6"
                                    Data="M4 16 L4 4 M4 16 H16.4" />
                                <TextBlock Text="Ángulo" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  Cuerpo: miniaturas · lienzo · propiedades  -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">

            <!--  Panel de hojas: miniaturas e índice  -->
            <rendering:PagesPanel
                x:Name="Pages"
                Grid.Column="0"
                Width="232"
                ActionRequested="OnPageActionRequested"
                Visibility="Collapsed" />

            <!--  Lienzo  -->
            <Grid Grid.Column="1">
                <!--  Las pestañas son solo la tira; el visor de la activa se aloja aquí.  -->
                <ContentControl
                    x:Name="ViewerPresenter"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

                <!--
                    Buscador de comandos. Aparece por encima del documento en
                    vez de en un diálogo: es una forma de llegar a un botón, no
                    una pregunta, y no debe apagar lo que hay detrás.
                -->
                <Border
                    x:Name="CommandPalette"
                    Width="440"
                    Margin="0,60,0,0"
                    Padding="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Shadow="{ThemeResource CommandBarFlyoutOverflowShadow}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBox
                            x:Name="CommandQuery"
                            KeyDown="OnCommandQueryKeyDown"
                            PlaceholderText="Buscar una herramienta o una acción…"
                            TextChanged="OnCommandQueryChanged" />
                        <ListView
                            x:Name="CommandList"
                            MaxHeight="320"
                            IsItemClickEnabled="True"
                            ItemClick="OnCommandChosen"
                            SelectionMode="Single" />
                    </StackPanel>
                </Border>

                <!--
                    Aviso de lo que acaba de pasar. Flota sobre el plano y no en
                    la barra de arriba a propósito: lo que confirma una copia
                    tiene que verse donde está mirando quien acaba de arrastrar
                    el recuadro, y el rótulo gris junto al nombre del documento
                    se pierde. Se va solo; no hay nada que cerrar.
                -->
                <Border
                    x:Name="Toast"
                    Margin="0,0,0,28"
                    Padding="16,11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Shadow="{ThemeResource CommandBarFlyoutOverflowShadow}"
                    Visibility="Collapsed">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="11"
                        VerticalAlignment="Center">
                        <controls:ToolIcon
                            x:Name="ToastIcon"
                            Width="19"
                            Height="19"
                            VerticalAlignment="Center"
                            Data="M4.2 10.4 L8.2 14.4 L15.8 6"
                            Foreground="{ThemeResource IconSaveBrush}"
                            Thickness="1.8" />
                        <TextBlock
                            x:Name="ToastText"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ToastDetail"
                            VerticalAlignment="Center"
                            Opacity="0.6" />
                    </StackPanel>
                </Border>

                <!--
                    Firmar escribe el archivo y no tiene vuelta atrás, así que la
                    firma se coloca primero y se escribe después. Mientras tanto
                    esta barra flota sobre el documento: se ve dónde va, se
                    arrastra y se puede tirar.
                -->
                <Border
                    x:Name="SignatureStrip"
                    Margin="0,12,0,0"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Shadow="{ThemeResource CommandBarFlyoutOverflowShadow}"
                    Visibility="Collapsed">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SignStripLabel"
                            VerticalAlignment="Center"
                            Text="Arrastra la firma para moverla" />
                        <Button
                            x:Name="SignConfirmButton"
                            Click="OnSignConfirmClicked"
                            Content="Firmar aquí"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="SignRedrawButton"
                            Click="OnSignRedrawClicked"
                            Content="Dibujarla otra vez" />
                        <Button
                            x:Name="SignDropButton"
                            Click="OnSignDropClicked"
                            Content="Quitarla" />
                    </StackPanel>
                </Border>

                <!--
                    Página de inicio. No es una pestaña: una pestaña es un
                    documento, y una fija al principio se lleva un sitio de la
                    tira y un salto del Ctrl+Tab a cambio de nada. Esto está
                    cuando no hay ningún plano abierto, y el desplegable de
                    «Abrir» lleva la misma lista cuando sí los hay.
                -->
                <ScrollViewer
                    x:Name="EmptyState"
                    HorizontalContentAlignment="Center"
                    HorizontalScrollMode="Disabled"
                    VerticalContentAlignment="Center"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        Padding="24,40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                        <controls:ToolIcon
                            Width="46"
                            Height="46"
                            HorizontalAlignment="Center"
                            Data="M5 3.4h6l4 4v9.2H5Z M11 3.4v4h4"
                            Opacity="0.32"
                            Thickness="1" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.55"
                            Text="Abre un documento para empezar" />

                        <StackPanel
                            x:Name="RecentSection"
                            Width="380"
                            Margin="0,14,0,0"
                            Spacing="2"
                            Visibility="Collapsed">
                            <TextBlock
                                Margin="10,0,0,4"
                                FontSize="12"
                                Opacity="0.5"
                                Text="Abiertos hace poco" />
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RecentEntry">
                                        <!--  El nombre va también en el automation name: el botón solo lleva dibujos y textos sueltos.  -->
                                        <Button
                                            Padding="10,7"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="{x:Bind FullPath}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnRecentClicked"
                                            CornerRadius="6"
                                            Tag="{x:Bind FullPath}"
                                            ToolTipService.ToolTip="{x:Bind FullPath}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <controls:ToolIcon
                                                    Width="17"
                                                    Height="17"
                                                    VerticalAlignment="Center"
                                                    Data="M5 3.4h6l4 4v9.2H5Z M11 3.4v4h4"
                                                    Opacity="0.5"
                                                    Thickness="1.3" />
                                                <StackPanel MaxWidth="300">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <!--  La carpeta, porque el mismo A-01 vive en cuatro proyectos.  -->
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.5"
                                                        Text="{x:Bind Folder}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  Propiedades de la herramienta activa  -->
            <Grid
                x:Name="PropertiesPanel"
                Grid.Column="2"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                RowDefinitions="46,*"
                Visibility="Collapsed">

                <StackPanel
                    Grid.Row="0"
                    Padding="16,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Orientation="Horizontal"
                    Spacing="10">
                    <!--
                        Dos iconos y no uno con la geometría cambiada: el dato
                        es una Geometry, y construirla desde código sería
                        analizar en C# lo que el XAML ya sabe leer.
                    -->
                    <controls:ToolIcon
                        x:Name="PropertiesIconText"
                        Width="15"
                        Height="15"
                        VerticalAlignment="Center"
                        Data="M8 3.5h4 M8 16.5h4 M10 3.5v13"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <controls:ToolIcon
                        x:Name="PropertiesIconMark"
                        Width="15"
                        Height="15"
                        VerticalAlignment="Center"
                        Data="M4 16.2h3.4l8.8-8.8a1.7 1.7 0 0 0 0-2.4l-1-1a1.7 1.7 0 0 0-2.4 0L4 12.8Z M11.6 5.6 14.8 8.8"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />
                    <controls:ToolIcon
                        x:Name="PropertiesIconCompare"
                        Width="15"
                        Height="15"
                        VerticalAlignment="Center"
                        Data="M3.4 3.4h8v9.2h-8Z M8.6 7.4h8v9.2h-8Z"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="PropertiesTitle"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Selección de texto" />
                </StackPanel>

                <!--
                    Apilado y no superpuesto: las dos secciones de herramienta
                    se excluyen entre sí, pero la comparación puede estar
                    puesta a la vez que se marca, y entonces la leyenda de
                    colores tiene que seguir viéndose debajo.
                -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel
                            x:Name="TextToolPanel"
                            Padding="16,20"
                            Spacing="14">
                            <TextBlock
                                x:Name="SelectionStatus"
                                Opacity="0.6"
                                Text="Arrastra sobre la página para seleccionar."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="CopySelectionButton"
                                HorizontalAlignment="Stretch"
                                Click="OnCopySelectionClicked"
                                IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M7 2.8h8.2a1.4 1.4 0 0 1 1.4 1.4v8.2 M4.8 5.6h7.6a1.4 1.4 0 0 1 1.4 1.4v8.2a1.4 1.4 0 0 1-1.4 1.4H4.8a1.4 1.4 0 0 1-1.4-1.4V7a1.4 1.4 0 0 1 1.4-1.4Z" />
                                    <TextBlock Text="Copiar" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="SelectAllButton"
                                HorizontalAlignment="Stretch"
                                Click="OnSelectAllClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.4 6.2V4.6a1.2 1.2 0 0 1 1.2-1.2h1.6 M16.6 6.2V4.6a1.2 1.2 0 0 0-1.2-1.2h-1.6 M3.4 13.8v1.6a1.2 1.2 0 0 0 1.2 1.2h1.6 M16.6 13.8v1.6a1.2 1.2 0 0 1-1.2 1.2h-1.6 M6.6 6.8h6.8v6.4H6.6Z" />
                                    <TextBlock Text="Seleccionar la página" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--
                            Marcas: color y grosor valen para la siguiente y, si
                            hay una cogida, para esa. Es lo que se espera al
                            elegir un color con algo seleccionado.
                        -->
                        <StackPanel
                            x:Name="MarkToolPanel"
                            Padding="16,20"
                            Spacing="16"
                            Visibility="Collapsed">
                            <StackPanel x:Name="ColourSection" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="Color" />
                                    <Border
                                        x:Name="CurrentColourSwatch"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="D82020"
                                        ToolTipService.ToolTip="Rojo">
                                        <Border Background="#D82020" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="F07A1E"
                                        ToolTipService.ToolTip="Naranja">
                                        <Border Background="#F07A1E" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="FFC800"
                                        ToolTipService.ToolTip="Amarillo">
                                        <Border Background="#FFC800" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="1E9B4B"
                                        ToolTipService.ToolTip="Verde">
                                        <Border Background="#1E9B4B" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="0067C0"
                                        ToolTipService.ToolTip="Azul">
                                        <Border Background="#0067C0" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="7B4BD6"
                                        ToolTipService.ToolTip="Violeta">
                                        <Border Background="#7B4BD6" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="E0359C"
                                        ToolTipService.ToolTip="Magenta">
                                        <Border Background="#E0359C" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="1C1C1C"
                                        ToolTipService.ToolTip="Negro">
                                        <Border Background="#1C1C1C" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!--
                                Relleno: su propio color, porque el caso típico
                                de revisión es una mancha clara con el borde en
                                otro color, y su propia opacidad, porque un
                                relleno opaco taparía justo las líneas que la
                                marca señala.
                            -->
                            <StackPanel x:Name="FillSection" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="Relleno" />
                                    <Border
                                        x:Name="CurrentFillSwatch"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3" />
                                    <TextBlock
                                        x:Name="FillStateText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.5" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Click="OnNoFillClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        ToolTipService.ToolTip="Sin relleno">
                                        <controls:ToolIcon
                                            Width="18"
                                            Height="18"
                                            Data="M3.5 3.5h13v13h-13Z M3.5 16.5 16.5 3.5"
                                            Thickness="1.3" />
                                    </Button>
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="FFC800"
                                        ToolTipService.ToolTip="Relleno amarillo">
                                        <Border Background="#FFC800" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="D82020"
                                        ToolTipService.ToolTip="Relleno rojo">
                                        <Border Background="#D82020" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="1E9B4B"
                                        ToolTipService.ToolTip="Relleno verde">
                                        <Border Background="#1E9B4B" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="0067C0"
                                        ToolTipService.ToolTip="Relleno azul">
                                        <Border Background="#0067C0" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="7B4BD6"
                                        ToolTipService.ToolTip="Relleno violeta">
                                        <Border Background="#7B4BD6" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="9AA0A6"
                                        ToolTipService.ToolTip="Relleno gris">
                                        <Border Background="#9AA0A6" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                    <Button
                                        Click="OnFillColourClicked"
                                        Style="{StaticResource SwatchButtonStyle}"
                                        Tag="1C1C1C"
                                        ToolTipService.ToolTip="Relleno negro">
                                        <Border Background="#1C1C1C" Style="{StaticResource SwatchStyle}" />
                                    </Button>
                                </StackPanel>

                                <StackPanel x:Name="FillOpacitySection" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0.7"
                                            Text="Opacidad" />
                                        <TextBlock
                                            x:Name="FillOpacityText"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0.5" />
                                    </StackPanel>
                                    <Slider
                                        x:Name="FillOpacitySlider"
                                        Maximum="100"
                                        Minimum="5"
                                        StepFrequency="5"
                                        TickFrequency="5"
                                        Value="35"
                                        ValueChanged="OnFillOpacityChanged" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="WidthSection" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="Grosor" />
                                    <TextBlock
                                        x:Name="WidthValueText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.5" />
                                </StackPanel>
                                <Slider
                                    x:Name="WidthSlider"
                                    Maximum="8"
                                    Minimum="0.5"
                                    StepFrequency="0.25"
                                    TickFrequency="0.25"
                                    Value="2"
                                    ValueChanged="OnWidthChanged" />
                            </StackPanel>

                            <StackPanel x:Name="FontSizeSection" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="Tamaño" />
                                    <TextBlock
                                        x:Name="FontSizeText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.5" />
                                </StackPanel>
                                <Slider
                                    x:Name="FontSizeSlider"
                                    Maximum="72"
                                    Minimum="6"
                                    StepFrequency="1"
                                    TickFrequency="1"
                                    Value="12"
                                    ValueChanged="OnFontSizeChanged" />
                            </StackPanel>

                            <!--  El texto aparece cuando hay una nota o un texto cogido.  -->
                            <StackPanel x:Name="NoteEditor" Spacing="6" Visibility="Collapsed">
                                <TextBlock
                                    x:Name="NoteEditorLabel"
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Comentario" />
                                <TextBox
                                    x:Name="NoteText"
                                    Height="120"
                                    AcceptsReturn="True"
                                    PlaceholderText="Qué hay que revisar"
                                    TextChanged="OnNoteTextChanged"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="DeleteMarkButton"
                                HorizontalAlignment="Stretch"
                                Click="OnDeleteMarkClicked"
                                IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:ToolIcon Style="{StaticResource BarIconStyle}" Data="M3.6 5.6h12.8 M8 5.6V3.8h4v1.8 M5.2 5.6l.8 10.4a1.2 1.2 0 0 0 1.2 1.1h5.6a1.2 1.2 0 0 0 1.2-1.1l.8-10.4" />
                                    <TextBlock Text="Eliminar la marca (Supr)" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                x:Name="MarkStatus"
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Comparar. La leyenda es la mitad del panel y no es
                            decoración: sobre el plano solo hay dos colores, y
                            lo único que dice cuál es el archivo nuevo y cuál el
                            viejo es esta lista con los nombres al lado. Sin
                            ella, «rojo» no significa nada.
                        -->
                        <StackPanel
                            x:Name="ComparePanel"
                            Padding="16,20"
                            Spacing="16"
                            Visibility="Collapsed">
                            <StackPanel Spacing="9">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border
                                        x:Name="CompareSheetSwatch"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0"
                                        CornerRadius="3" />
                                    <TextBlock
                                        x:Name="CompareSheetName"
                                        MaxWidth="200"
                                        FontSize="12"
                                        Text="Este documento"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border
                                        x:Name="CompareRevisionSwatch"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0"
                                        CornerRadius="3" />
                                    <TextBlock
                                        x:Name="CompareRevisionName"
                                        MaxWidth="200"
                                        FontSize="12"
                                        Text="La revisión"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0"
                                        Background="#8C8C8C"
                                        CornerRadius="3" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.75"
                                        Text="En las dos: no ha cambiado"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                x:Name="ComparePairing"
                                FontSize="12"
                                Opacity="0.6"
                                TextWrapping="Wrap" />

                            <!--
                                Cuánto se ve el dibujo que no ha cambiado. A
                                cero desaparece y solo quedan los cambios, que
                                es lo que se quiere para enseñarlos; alto deja
                                el plano entero de contexto, que es lo que se
                                quiere para entenderlos.
                            -->
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Fondo sin cambios" />
                                <Slider
                                    x:Name="CompareCommonSlider"
                                    Maximum="255"
                                    Minimum="0"
                                    StepFrequency="5"
                                    ValueChanged="OnCompareCommonChanged" />
                            </StackPanel>

                            <TextBlock
                                x:Name="CompareStatus"
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Calibrar. El panel dice a qué está dibujada la hoja
                            en la que se está, porque es lo único que hace
                            fiable un número: una medida sin saber la escala es
                            una cifra con una unidad pegada detrás.
                        -->
                        <StackPanel
                            x:Name="MeasurePanel"
                            Padding="16,20"
                            Spacing="16"
                            Visibility="Collapsed">
                            <!--
                                Lo que la marca elegida mide, con lo que no cabe
                                en la hoja: un área trae su perímetro, y un
                                perímetro cerrado trae lo que encierra. Es lo
                                que se pregunta justo después, y ponerlo sobre
                                el plano sería tapar el dibujo con dos cifras
                                donde se pidió una.
                            -->
                            <StackPanel x:Name="MeasureDetailSection" Spacing="4" Visibility="Collapsed">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Esta medida" />
                                <TextBlock
                                    x:Name="MeasureDetailText"
                                    FontSize="14"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Esta hoja" />
                                <TextBlock
                                    x:Name="SheetScaleText"
                                    FontSize="14"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                FontSize="12"
                                Opacity="0.55"
                                Text="Arrastra sobre una distancia conocida —una cota del plano, una escala gráfica— y di cuánto mide de verdad."
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="ClearScaleButton"
                                Click="OnClearScaleClicked"
                                Content="Quitar la calibración"
                                IsEnabled="False"
                                Style="{StaticResource SlimButtonStyle}" />

                            <TextBlock
                                FontSize="12"
                                Opacity="0.55"
                                Text="La escala viaja con la hoja: si la mueves o la llevas a otro archivo, va con ella."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
