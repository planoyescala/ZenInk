<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ZenInk_App.Controls.ToolIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <Viewbox Stretch="Uniform">
        <!--
            An explicit 20x20 box for both the frame and the path, so the icon
            always occupies the whole grid it was drawn on rather than the
            bounds of whichever strokes it happens to contain.
        -->
        <Grid Width="20" Height="20">
            <Path
                x:Name="IconPath"
                Width="20"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stretch="None"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round" />
        </Grid>
    </Viewbox>
</UserControl>
