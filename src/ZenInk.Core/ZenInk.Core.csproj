<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZenInk.Core</RootNamespace>
    <!--
      Two of PDFium's annotation entry points take an array of points, which
      the generated wrapper cannot express. See PdfiumInk.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The engine deliberately has no UI dependency: it knows about PDF pages,
    tiles, text and paper, and nothing about WinUI. That is what lets the test
    suite drive it without opening a window, and what will let a print or an
    export path reuse it unchanged.
  -->
  <ItemGroup>
    <PackageReference Include="PDFiumCore" Version="153.0.7999" />
    <!--
      CMS/CAdES for signing. It is Microsoft's own, MIT, and it is not in the
      plain net10.0 shared framework — only the Windows Desktop one — so it has
      to be asked for by name. Nothing else is needed to sign: the key stays in
      the Windows store and this signs through its handle.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
  </ItemGroup>

</Project>
